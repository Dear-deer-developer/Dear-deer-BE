// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LetterStatus {
  WRITING
  SENT
  RECEIVED
}

enum ScheduleCategory {
  APPOINTMENT
  POPUP
  RESERVATION
  ETC
}

enum GiftCategory {
  ORNAMENT
  STAR
  ELECTRIC_BULB
  WALLPAPER
  GARLAND
  CARPET
  TRAIN
  GIFTBOX
  ANIMAL
  EVENT
}

enum Platform {
  IOS
  ANDROID
  OTHER
}

enum LoginType {
  NATIVE // 자체 로그인 (이메일/비밀번호)
  SOCIAL // 소셜 로그인 (Firebase)
}

model User {
  id               Int       @id @default(autoincrement())
  email            String?   @unique // (10.13 자체로그인시에만 저장)
  hashedPassword   String?   @map("hashed_password") // 자체로그인시 저장
  nickname         String    @unique
  zipCode          Int       @unique @map("zip_code")
  loginType        LoginType @default(NATIVE) @map("login_type")
  providerId       String?   @unique @map("provider_id") // 소셜로그인시 저장
  isAdmin          Boolean   @default(false) @map("is_admin")
  isAgreed         Boolean   @default(false) @map("is_agreed")
  lastGiftViewedAt DateTime? @map("last_gift_viewed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  refreshToken          RefreshToken?
  sentLetters           Letter[]               @relation("SentLetters")
  receivedLetters       Letter[]               @relation("ReceivedLetters")
  schedule              Schedule[]
  deviceTokens          DeviceToken[]
  alarms                Alarm[]
  contents              Content[]
  scraps                Scrap[]
  contentViews          ContentView[]
  userGifts             UserGift[]
  userEquipSlots        UserEquipSlot[]
  calendarRewardRecords CalendarRewardRecord[]

  @@map("users")
}

// 이메일 인증 코드 테이블
model AuthCode {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  code         String
  isVerified   Boolean  @default(false) @map("is_verified") // 인증 완료 상태
  attemptCount Int      @default(0) @map("attempt_count") // 시도 횟수 카운트
  expiredAt    DateTime @map("expired_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("auth_codes")
}

// refreshToken 저장 테이블
model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id") // User와 1:1 관계
  token     String // 실제 토큰 값
  expiresAt DateTime @map("expires_at") // 토큰 만료 시간
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Letter {
  id         Int          @id @default(autoincrement())
  senderId   Int          @map("sender_id")
  receiverId Int?         @map("receiver_id")
  content    String
  imageUrl   String?      @map("image_url")
  paperId    Int          @map("paper_id")
  status     LetterStatus
  sentAt     DateTime?    @map("sent_at") // 전송 시각, 전송 전엔 NULL
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  sender   User        @relation("SentLetters", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User?       @relation("ReceivedLetters", fields: [receiverId], references: [id], onDelete: SetNull)
  paper    LetterPaper @relation(fields: [paperId], references: [id], onDelete: Restrict)

  @@map("letters")
}

model LetterPaper {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  // Letter와의 관계 설정 (Letter 쪽에서 참조)
  letters Letter[]

  @@map("letter_papers")
}

model Schedule {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  title     String
  memo      String?
  category  ScheduleCategory
  date      DateTime
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("schedules")
}

model Gift {
  id       Int          @id @default(autoincrement())
  name     String       @unique
  category GiftCategory

  userGifts     UserGift[]
  equippedSlots UserEquipSlot[]
  rewardPlan    CalendarRewardPlan[]
  rewardRecord  CalendarRewardRecord[]

  @@index([category])
  @@map("gifts")
}

model UserGift {
  userId     Int      @map("user_id")
  giftId     Int      @map("gift_id")
  obtainedAt DateTime @default(now()) @map("obtained_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gift Gift @relation(fields: [giftId], references: [id], onDelete: Restrict)

  @@id([userId, giftId])
  @@index([userId])
  @@map("user_gifts")
}

model DeviceToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique // FCM 토큰
  platform  Platform
  isActive  Boolean  @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model Alarm {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique @map("user_id")
  scheduledAt DateTime @map("scheduled_at") // 알림 설정 시간(KST 기준 설정)
  isFired     Boolean  @default(false) @map("is_fired") // 울렸는지 상태 체크
  musicId     Int      @map("music_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  music Music @relation(fields: [musicId], references: [id], onDelete: Restrict)

  @@index([isFired, scheduledAt])
  @@map("alarms")
}

model Music {
  id        Int      @id @default(autoincrement())
  title     String
  artist    String
  createdAt DateTime @default(now()) @map("created_at")
  alarms    Alarm[]

  @@map("musics")
}

model Content {
  id        Int           @id @default(autoincrement())
  title     String
  body      String
  status    ContentStatus @default(WRITING)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  // Relations
  authorId      Int       @map("author_id")
  author        User               @relation(fields: [authorId], references: [id], onDelete: Restrict)
  subCategoryId Int @map("sub_category_id")
  subCategory   ContentSubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Restrict)
  images        ContentImage[]
  scraps        Scrap[]
  views         ContentView[]

  @@map("contents")
}

model ContentImage {
  id        Int      @id @default(autoincrement())
  contentId Int      @map("content_id")
  url       String   @map("url")
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("content_images")
}

model ContentMainCategory {
  id   Int                  @id @default(autoincrement())
  name String
  subs ContentSubCategory[]

  @@map("content_main_categories")
}

model ContentSubCategory {
  id             Int                 @id @default(autoincrement())
  name           String
  mainCategoryId Int @map("main_category_id")
  mainCategory   ContentMainCategory @relation(fields: [mainCategoryId], references: [id], onDelete: Restrict )
  contents       Content[]

  @@map("content_sub_categories")
}

enum ContentStatus {
  WRITING
  PUBLISHED
  HIDDEN
}

model Scrap {
  id        Int      @id @default(autoincrement())
  userId    Int @map("user_id")
  contentId Int @map("content_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@map("scraps")
}

model ContentView {
  id        Int      @id @default(autoincrement())
  userId    Int @map("user_id")
  contentId Int @map("content_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@map("content_views")
}

// 카테고리 별 장착 가능한 용량 (capacity)
model EquipCategoryRule {
  category GiftCategory @id
  capacity Int

  @@map("equip_category_rules")
}

// 장착 가능한 슬롯 집합
model EquipCategorySlot {
  category      GiftCategory
  slot          Int
  UserEquipSlot UserEquipSlot[]

  @@id([category, slot]) // ornament 카테고리는 12개라서 필요함. 
  @@map("equip_category_slots")
}

// 장착 상태 (1슬롯 = 1행)
model UserEquipSlot {
  userId   Int          @map("user_id")
  category GiftCategory
  slot     Int // 1..capacity  (EquipGroupSlot FK로 강제)
  giftId   Int          @map("gift_id")

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupSlot EquipCategorySlot @relation(fields: [category, slot], references: [category, slot], onDelete: Restrict)
  gift      Gift              @relation(fields: [giftId], references: [id], onDelete: Restrict)

  @@id([userId, category, slot]) // "한 슬롯엔 하나"
  @@unique([userId, giftId]) // 같은 선물 중복 장착 금지
  @@index([userId, category]) // 그룹별 조회
  @@index([userId])
  @@map("user_equip_slots")
}

// 날짜별 지급 계획
model CalendarRewardPlan {
  localDate DateTime @unique @db.Date
  giftId    Int      @map("gift_id")

  gift Gift @relation(fields: [giftId], references: [id], onDelete: Restrict)

  @@index([giftId])
  @@map("calendar_reward_plans")
}

// 유저의 일별 수령 기록 (하루 1회)
model CalendarRewardRecord {
  userId     Int      @map("user_id")
  localDate  DateTime @db.Date @map("local_date")
  giftId     Int      @map("gift_id")
  receivedAt DateTime @default(now()) @map ("received_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gift Gift @relation(fields: [giftId], references: [id], onDelete: Restrict)

  @@id([userId, localDate])
  @@index([giftId])
  @@map("calendar_reward_records")
}
